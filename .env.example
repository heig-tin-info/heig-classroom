# Copy to .env -- never put a real secret in this example file (ADR-010).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
WORKER_MODE=all
DATABASE_URL=postgres://hgc:hgc@localhost:5432/hgc
LOG_LEVEL=info
# Apply the Drizzle migrations at startup (1/true). Off in dev: run
# `pnpm --filter @hgc/server db:migrate` by hand. On in the container image.
#MIGRATE_ON_START=1
# Directory of the built SPA (apps/web/dist). Empty = API only, which is what
# you want when Vite serves the front end in dev.
#STATIC_DIR=

# OIDC -- local Keycloak in dev (docker-compose.dev.yml), Switch edu-ID in prod.
# Frontend dev with Vite/HMR: set http://localhost:5173 (proxies /app to :3000).
# Both callbacks are allowed by the dev realm (infra/keycloak/hgc-dev-realm.json).
PUBLIC_URL=http://localhost:5173
OIDC_ISSUER=http://localhost:8080/realms/hgc-dev
OIDC_CLIENT_ID=hgc-portal
OIDC_CLIENT_SECRET=dev-secret-not-for-production
COOKIE_SECRET=dev-cookie-secret-change-me
# `private_key_jwt` client authentication (what SWITCH recommends): PKCS8
# private key whose public JWK is registered in the Resource Registry. Empty =
# client_secret authentication, which is what the dev Keycloak uses.
#OIDC_PRIVATE_KEY_PATH=secrets/eduid-private-key.pem
# Key id advertised in the JWT header; only read when OIDC_PRIVATE_KEY_PATH is set.
#OIDC_PRIVATE_KEY_KID=hgc-eduid-2026
# Idle timeout: sessions renew while in use (sliding expiry). Max 720 (30 days).
SESSION_TTL_HOURS=12

# Super administrator (manages teachers from the portal's admin screen).
SUPER_ADMIN_EMAIL=teacher@heig-vd.ch

# GitHub App (provisioning, webhooks) -- created inside the target organization,
# permissions per GH-02 (docs/02). The PEM lives in secrets/ (gitignored).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=secrets/hgc-dev.private-key.pem
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Account linking: user-to-server OAuth client of the GitHub App itself
# (Settings -> the App -> Client ID / Generate a client secret). No separate
# OAuth App. Callback: http://localhost:3000/app/auth/github/callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Email provider (Scaleway Transactional Email). Without SCW_SECRET_KEY +
# SCW_DEFAULT_PROJECT_ID the mailer dry-runs: emails are logged, never sent.
# The sending domain (MAIL_FROM) must be validated in the Scaleway console
# (SPF/DKIM/DMARC), or everything lands in spam.
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=
MAIL_FROM=no-reply@chevallier.io
MAIL_FROM_NAME=HEIG Classroom
MAIL_REGION=fr-par

# Online workspace portal (apps/codespace, ADR-013). EMPTY = the feature does
# not exist: no admin column, no work-mode selector, /app/codespace/* is 404.
# In dev the portal listens on 3100 so it does not collide with classroom (3000).
# CODESPACE_LAUNCH_SECRET is the HS256 secret SHARED with the portal (same
# value in its own env): at least 32 characters, or the server refuses to boot.
# Generate with: openssl rand -hex 32
CODESPACE_URL=http://localhost:3100
CODESPACE_LAUNCH_SECRET=dev-codespace-launch-secret-change-me
