# Copy to .env.prod (chmod 600). Never put a real secret in this file.
LOG_LEVEL=info
SESSION_TTL_HOURS=12

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
COOKIE_SECRET=
KEYCLOAK_ADMIN_PASSWORD=

# Super administrator (single) -- teachers are managed in the admin screen
SUPER_ADMIN_EMAIL=yves.chevallier@heig-vd.ch

# --- OIDC ---
# Transitional phase (Keycloak on /kc):
OIDC_ISSUER=https://classroom.chevallier.io/kc/realms/hgc-dev
OIDC_CLIENT_ID=hgc-portal
OIDC_CLIENT_SECRET=
# edu-ID switchover (see deploy.md §7):
#OIDC_ISSUER=<edu-ID issuer>
#OIDC_CLIENT_ID=<SWITCH client id>
#OIDC_PRIVATE_KEY_PATH=secrets/eduid-private-key.pem
#OIDC_PRIVATE_KEY_KID=hgc-eduid-2026

# --- PROD GitHub App (hgc-prod) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=secrets/hgc-prod.private-key.pem
GITHUB_APP_SLUG=hgc-prod
GITHUB_WEBHOOK_SECRET=

# --- PROD OAuth App ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Online workspace portal (apps/codespace, ADR-013) ---
# Empty = feature absent. Set it only once the portal VM is up; the same
# CODESPACE_LAUNCH_SECRET must be configured on the portal side.
# Generate with: openssl rand -hex 32
CODESPACE_URL=
CODESPACE_LAUNCH_SECRET=
