        "student"
      ]
    },
    {
      "username": "student2",
      "enabled": true,
      "email": "student2@heig-vd.ch",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Student",
      "credentials": [
        {
          "type": "password",
          "value": "student2",
          "temporary": false
        }
      ],
      "realmRoles": [
        "student"
      ]
    }
  ],
  "roles": {
