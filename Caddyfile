# NATIVE Caddy (apt) -- installed as this project's fragment (the host
# /etc/caddy/Caddyfile only imports /etc/caddy/conf.d/*.caddy), as srv:
#   cp Caddyfile /etc/caddy/conf.d/classroom.caddy
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   sudo systemctl reload caddy
classroom.chevallier.io {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# SSE: unbuffered stream (docs/03, ADR-005)
	handle /app/events {
		reverse_proxy localhost:3000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy localhost:3000
	}
}
