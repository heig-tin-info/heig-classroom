# heig-codespace — TLS frontend. Installed by deploy/bootstrap.sh as
# /etc/caddy/Caddyfile, with @DOMAIN@ substituted along the way.
#
# The certificate comes from Let's Encrypt, obtained by Caddy itself (HTTP-01
# on port 80, left open by the Hetzner firewall).
#
# Websocket upgrades pass through **natively**: since Caddy 2, `reverse_proxy`
# relays `Connection: Upgrade` with no special directive. code-server depends
# on it entirely (docs/v1.md, TODO(verify) on the `/?reconnectionToken=…`
# endpoint).
#
# The portal listens on 127.0.0.1:3100 and nothing else: Caddy is the only
# path in from the outside. The Git channel (9418) is bound to 10.77.0.254, on
# the bridge side, and is not proxied — that is the whole point of invariant 1.

@DOMAIN@ {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# Caddy advertises itself by default; no reason to hand that out.
		-Server
	}

	log {
		output file /var/log/caddy/codespace.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}

	reverse_proxy 127.0.0.1:3100 {
		# code-server sends long frames; the open tab is a heartbeat
		# (proxy/index.ts). No buffering on the stream.
		flush_interval -1

		# X-Forwarded-For is added HERE, by `reverse_proxy` itself and
		# with no directive: since Caddy 2 it appends the client address
		# to that header on every upstream request, together with
		# X-Forwarded-Proto and X-Forwarded-Host. Nothing to configure —
		# and nothing to remove either: the portal's exam cookie is bound
		# to the client address, and it only sees it because of this
		# header plus TRUSTED_PROXY_IPS=127.0.0.1 on the portal side,
		# which declares this hop trusted (docs/deploy.md § 6). Adding a
		# `header_up X-Forwarded-*` line here would override the default
		# rather than add to it: do not, unless you know why.
	}
}
