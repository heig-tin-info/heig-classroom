NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3100
DATABASE_PATH=./var/codespace.sqlite

# Moteur (toujours en mode distant, voir docs/setup-poste.md)
PODMAN_URL=unix:///run/podman/podman.sock
CODESPACE_NETWORK=codespace
CODESPACE_GATEWAY=10.77.0.254
CODESPACE_GIT_PORT=9418
VOLUMES_ROOT=./var/volumes
SECCOMP_PROFILE=./infra/seccomp/codespace.json
CODESPACE_IMAGE=codespace/c-dev:4.137.0
CODESPACE_MEMORY=1536m
CODESPACE_CPUS=1
CODESPACE_PIDS_LIMIT=256

# Cycle de vie des sessions (millisecondes)
SESSION_GRACE_MS=600000
SESSION_GC_INTERVAL_MS=60000
SHADOW_INTERVAL_MS=180000
SESSION_HEALTH_TIMEOUT_MS=30000

# OIDC dev (Keycloak, infra/compose.dev.yml). Invariant 4 : réel même en dev.
OIDC_ISSUER=http://localhost:8080/realms/codespace-dev
OIDC_CLIENT_ID=codespace-portal
OIDC_CLIENT_SECRET=dev-secret-not-for-production
# Revendication portant les rôles de realm (mappeur `codespace-roles` du realm)
OIDC_ROLES_CLAIM=codespace_roles
OIDC_TEACHER_ROLE=teacher
COOKIE_SECRET=dev-cookie-secret-change-me
SESSION_TTL_HOURS=12

# Forge de dev (Forgejo, infra/compose.dev.yml)
FORGE_KIND=forgejo
FORGE_URL=http://localhost:3300
FORGE_TOKEN=
FORGE_USER=codespace

# --- Intégration heig-classroom (apps/server) -------------------------------
# Secret HS256 partagé, identique des deux côtés. Vide = intégration
# désactivée : /launch et /api/assignments/* répondent 404 et le portail reste
# utilisable en autonome avec sa propre connexion OIDC.
# Trente-deux caractères au minimum. Voir docs/integration-classroom.md.
CODESPACE_LAUNCH_SECRET=dev-launch-secret-change-me-0123456789
# Origine publique de classroom : startURL des .seb et hôte autorisé par SEB.
CLASSROOM_URL=http://localhost:3000
# Image d'un devoir synchronisé dont `image` vaut null.
CODESPACE_DEFAULT_IMAGE=codespace/c-dev:4.137.0

# SEB : "real" en production, "simulated" autorisé uniquement hors production
SEB_VERIFIER=simulated
# Origine sur laquelle SEB calcule ses hachés (analyse.md 4.6). Obligatoire en
# production ; vide en dev = reconstruction depuis l'en-tête Host.
SEB_PUBLIC_ORIGIN=
# Hôtes autorisés par le filtre d'URL de SEB en plus de classroom et du
# portail : le fournisseur d'identité (docs/pistes.md). Séparés par des virgules.
SEB_EXTRA_ALLOWED_HOSTS=localhost:8080
EXAM_COOKIE_SECRET=dev-exam-cookie-secret-change-me
EXAM_COOKIE_MAX_AGE_MS=14400000

# DÉVELOPPEMENT UNIQUEMENT. Rend request.ip contrôlable par X-Forwarded-For,
# ce dont scripts/e2e.ts a besoin pour simuler un second poste. loadConfig()
# refuse de démarrer avec NODE_ENV=production.
TRUST_PROXY=
