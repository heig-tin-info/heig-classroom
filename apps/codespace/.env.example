NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3100
DATABASE_PATH=./var/codespace.sqlite

# Engine (always in remote mode, see docs/setup-poste.md)
PODMAN_URL=unix:///run/podman/podman.sock
CODESPACE_NETWORK=codespace
CODESPACE_GATEWAY=10.77.0.254
CODESPACE_GIT_PORT=9418
VOLUMES_ROOT=./var/volumes
SECCOMP_PROFILE=./infra/seccomp/codespace.json
CODESPACE_IMAGE=codespace/c-dev:4.137.0
CODESPACE_MEMORY=1536m
CODESPACE_CPUS=1
CODESPACE_PIDS_LIMIT=256

# Session lifecycle (milliseconds)
SESSION_GRACE_MS=600000
SESSION_GC_INTERVAL_MS=60000
SHADOW_INTERVAL_MS=180000
SESSION_HEALTH_TIMEOUT_MS=30000

# Dev OIDC (Keycloak, docker-compose.dev.yml at the repository root).
# Invariant 4: real even in dev.
OIDC_ISSUER=http://localhost:8080/realms/hgc-dev
OIDC_CLIENT_ID=codespace-portal
OIDC_CLIENT_SECRET=dev-secret-not-for-production
# Claim carrying the realm roles (`codespace-roles` mapper of the realm)
OIDC_ROLES_CLAIM=codespace_roles
OIDC_TEACHER_ROLE=teacher
COOKIE_SECRET=dev-cookie-secret-change-me
SESSION_TTL_HOURS=12

# Dev forge (Forgejo, infra/compose.dev.yml)
FORGE_KIND=forgejo
FORGE_URL=http://localhost:3300
FORGE_TOKEN=
FORGE_USER=codespace

# --- heig-classroom integration (apps/server) -------------------------------
# Shared HS256 secret, identical on both sides. Empty = integration disabled:
# /launch and /api/assignments/* answer 404 and the portal stays usable
# standalone with its own OIDC sign-in.
# Thirty-two characters minimum. See docs/integration-classroom.md.
CODESPACE_LAUNCH_SECRET=dev-launch-secret-change-me-0123456789
# Public origin of classroom: startURL of the .seb files, and host allowed by SEB.
CLASSROOM_URL=http://localhost:3000
# Image of a synchronised assignment whose `image` is null.
CODESPACE_DEFAULT_IMAGE=codespace/c-dev:4.137.0

# SEB: "real" in production, "simulated" allowed outside production only
SEB_VERIFIER=simulated
# Origin on which SEB computes its hashes (analyse.md 4.6). Mandatory in
# production; empty in dev = rebuilt from the Host header.
SEB_PUBLIC_ORIGIN=
# Hosts allowed by SEB's URL filter besides classroom and the portal: the
# identity provider (docs/pistes.md). Comma-separated.
SEB_EXTRA_ALLOWED_HOSTS=localhost:8080
EXAM_COOKIE_SECRET=dev-exam-cookie-secret-change-me
EXAM_COOKIE_MAX_AGE_MS=14400000

# DEVELOPMENT ONLY. Makes request.ip controllable through X-Forwarded-For,
# which scripts/e2e.ts needs in order to simulate a second workstation.
# loadConfig() refuses to start with NODE_ENV=production.
TRUST_PROXY=
