{
  "name": "heig-classroom",
  "private": true,
  "version": "0.1.0",
  "description": "HEIG GitHub Classroom — teacher/student portal backed by GitHub",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @hgc/server dev",
    "docs:translate": "tsx scripts/docs-translate.ts",
    "docs:build": "bash scripts/docs-build.sh"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.25.0": ">=0.28.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
